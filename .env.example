NODE_ENV=development
APP_ORIGIN=http://localhost:4200
DATABASE_PATH=./data/securedesk.dev.sqlite
TEST_DATABASE_PATH=./data/securedesk.test.sqlite
E2E_DATABASE_PATH=./data/securedesk.e2e.sqlite
CSRF_SECRET=replace-with-output-of-openssl-rand-base64-32
TOTP_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
COOKIE_SECURE=false
# Client IP (per-IP limits). The edge reverse proxy must OVERWRITE X-Forwarded-For with the address
# it saw, not append to what the client sent. The address used is the entry TRUSTED_PROXY_HOPS
# places from the right of the header (1 = the proxy right in front of the app), never the leftmost.
TRUST_PROXY=true
TRUSTED_PROXY_HOPS=1
# CAPTCHA provider selection is server-side. Cloudflare's published 1x/2x/3x test keys are useful
# locally but are refused when NODE_ENV=production.
CAPTCHA_LOGIN_PROVIDER=internal
CAPTCHA_PASSWORD_CHANGE_PROVIDER=turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CAPTCHA_EXPECTED_HOSTNAME=localhost
CAPTCHA_MAX_TOKEN_AGE_SECONDS=120
CAPTCHA_VERIFY_TIMEOUT_MS=3000
CAPTCHA_HMAC_SECRET=replace-with-output-of-openssl-rand-base64-32
# Optional: after five consecutive Turnstile outages, serve the internal challenge for five
# minutes. Leave unset to keep password changes strictly fail-closed.
# CAPTCHA_FALLBACK=internal
# Optional Google reCAPTCHA v3 provider. Set CAPTCHA_PASSWORD_CHANGE_PROVIDER=recaptcha and
# provide both values; RECAPTCHA_MIN_SCORE defaults to 0.5.
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5
# Test-only: the internal provider additionally accepts TEST-SOLVED. Production refuses the flag.
# CAPTCHA_TEST_MODE=true
