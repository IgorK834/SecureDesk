{
  "name": "securedesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names frontend,backend --prefix-colors cyan,magenta \"npm run start -w apps/frontend\" \"npm run dev -w apps/backend\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run check:sec-traceability && npm run check:image-locations && npm run check:canary-urls && npm run check:aws-key-patterns && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:module2": "playwright test tests/e2e/lockout.spec.ts tests/e2e/captcha-login.spec.ts tests/e2e/captcha-password-change.spec.ts tests/e2e/honeypot.spec.ts tests/e2e/honeytoken.spec.ts tests/e2e/bot-sim.spec.ts tests/e2e/security-events.spec.ts",
    "check:sec-traceability": "node --experimental-strip-types scripts/check-sec-traceability.ts",
    "check:image-locations": "node --experimental-strip-types scripts/check-image-locations.ts",
    "check:canary-urls": "node --experimental-strip-types scripts/check-canary-urls.ts",
    "check:aws-key-patterns": "node --experimental-strip-types scripts/check-aws-key-patterns.ts",
    "db:generate": "npm run db:generate -w apps/backend",
    "db:migrate": "npm run db:migrate -w apps/backend",
    "db:migrate:test": "npm run db:migrate:test -w apps/backend",
    "db:reset:dev": "npm run db:reset:dev -w apps/backend",
    "db:reset:test": "npm run db:reset:test -w apps/backend",
    "db:seed": "npm run db:seed -w apps/backend",
    "db:seed:test": "npm run db:seed:test -w apps/backend",
    "maintenance:purge": "npm run maintenance:purge -w apps/backend",
    "admin:unlock": "npm run admin:unlock -w apps/backend --",
    "bot-sim": "node --experimental-strip-types scripts/bot-sim/bot-sim.ts"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.5"
    }
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
