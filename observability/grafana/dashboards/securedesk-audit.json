{
  "uid": "securedesk-audit",
  "title": "SecureDesk audit",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Failed logins per minute",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "securedesk-loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum(count_over_time({app=\"securedesk\",stream=\"audit\"} | json | action=\"AUTH_LOGIN_FAILURE\" [1m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Audit alerts",
      "type": "logs",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "securedesk-loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{app=\"securedesk\",stream=\"audit\"} | json | action=~\"ALERT_RAISED|AUDIT_TAMPER_DETECTED|HONEYTOKEN_ALERT_RECEIVED\""
        }
      ]
    }
  ]
}
