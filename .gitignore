# Dependencies
node_modules/

# Build output and caches
.next/
dist/
.angular/
coverage/
*.tsbuildinfo
next-env.d.ts

# Secrets and local configuration (only the placeholder template is tracked)
.env*
!.env.example

# Database files must never be committed (data/ is where DATABASE_PATH points)
data/
*.sqlite*
*.db
head-anchor.json
*.head-anchor.json
security-alerts.jsonl

# Local scratch space
.local/
tests/e2e/.credentials.json
tmp/
__pycache__/
*.pyc

# Generated reports and run output stay out of Git (attach finished reports to a release).
# output/.gitkeep keeps the directory so the report and bot-sim scripts can write into it.
output/*
!output/.gitkeep

# The course assignment PDF is not ours to publish
**/Cyberbezpieczenstwo_*.pdf

# OS / editors
.DS_Store
.idea/
.vscode/
